rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function isString(value) {
      return value is string;
    }

    // After merge, the resulting user doc must keep a non-empty name + avatarUrl string.
    function isValidUser(data) {
      return isString(data.name)
        && data.name.size() > 0
        && data.name.size() < 80
        && isString(data.avatarUrl);
    }

    function onlyAddingSelfAsContact() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
        && request.resource.data.contacts is list
        && uid() in request.resource.data.contacts
        && (
          !('contacts' in resource.data)
          || (
            resource.data.contacts is list
            && request.resource.data.contacts.hasAll(resource.data.contacts)
            && request.resource.data.contacts.size() <= resource.data.contacts.size() + 1
          )
        );
    }

    // Owner can patch online/lastSeen/fcm without re-validating full profile shape.
    function onlyPresenceOrTokens() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['isOnline', 'lastSeen', 'fcmTokens', 'notificationsEnabled']);
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatParticipant(chatId) {
      return signedIn() && uid() in chatDoc(chatId).participantIds;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['type', 'participantIds', 'lastMessage'])
        && data.type in ['direct', 'group']
        && data.participantIds is list
        && data.participantIds.size() >= 1
        && data.participantIds.size() <= 256
        && (data.type != 'direct' || data.participantIds.size() == 2);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'type', 'timestamp'])
        && data.senderId == uid()
        && isString(data.text)
        && data.text.size() < 4000
        && data.type in ['text', 'image', 'audio', 'system'];
    }

    function isValidStatus(data) {
      return data.userId == uid()
        && data.type in ['image', 'text']
        && data.privacyMode in ['everyone', 'contacts', 'contacts_except', 'only_share_with', 'nobody']
        && data.visibleTo is list
        && data.expiresAt is timestamp;
    }

    function onlyStatusViewersOrReactions() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['viewers', 'reactions']);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && (
          isValidUser(request.resource.data) || onlyPresenceOrTokens()
        )
        || onlyAddingSelfAsContact();
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && uid() in resource.data.participantIds;
      allow create: if signedIn()
        && isValidChat(request.resource.data)
        && uid() in request.resource.data.participantIds;
      allow update: if signedIn()
        && uid() in resource.data.participantIds
        && isValidChat(request.resource.data);
      allow delete: if signedIn()
        && uid() in resource.data.admins
        && resource.data.type == 'group';

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) && isValidMessage(request.resource.data);
        allow update: if isChatParticipant(chatId);
        allow delete: if isChatParticipant(chatId) && resource.data.senderId == uid();
      }
    }

    match /statuses/{statusId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || resource.data.privacyMode == 'everyone'
        || uid() in resource.data.visibleTo
      );
      allow create: if signedIn() && isValidStatus(request.resource.data);
      allow update: if signedIn() && (
        resource.data.userId == uid()
        || onlyStatusViewersOrReactions()
      );
      allow delete: if signedIn() && resource.data.userId == uid();
    }

    match /calls/{callId} {
      allow read: if signedIn() && uid() in resource.data.participantIds;
      allow create: if signedIn()
        && uid() in request.resource.data.participantIds
        && request.resource.data.callerId is string
        && request.resource.data.kind in ['voice', 'video'];
      allow update: if signedIn() && uid() in resource.data.participantIds;
      allow delete: if false;
    }

    // Compressed photos / avatars / status images (no Cloud Storage).
    match /media/{mediaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.keys().hasAll(['ownerId', 'kind', 'contentType', 'bytes', 'createdAt']);
      allow update, delete: if signedIn() && resource.data.ownerId == uid();
    }
  }
}
